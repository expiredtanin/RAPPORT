# Kopie nach .env.local und Werte einsetzen.
# .env.local ist via .gitignore ausgeschlossen — niemals committen.
#
# Lokales PocketBase (siehe pb/README.md — `./pocketbase serve`):
#   URL ist im Dev-Setup immer http://127.0.0.1:8090
# Mac-Mini im LAN: URL = http://<mac-mini.local>:8090 oder Tailscale-IP

VITE_POCKETBASE_URL=http://127.0.0.1:8090
