# Kopiere nach .env und ersetze die markierten Werte.
# Niemals committen — .env steht in .gitignore.

# ═══ Pflicht: Erster Superuser-Account (PocketBase-Admin-UI unter /_/) ═══
PB_SUPERUSER_EMAIL=admin@rapport.studio.ch
PB_SUPERUSER_PASSWORD=CHANGE-ME-mindestens-8-zeichen

# ═══ Pflicht: URLs ═══
# Wenn nur LAN: API_EXTERNAL_URL=http://192.168.1.50:8090
# Wenn extern via Reverse-Proxy: API_EXTERNAL_URL=https://api.rapport.studio.ch
API_EXTERNAL_URL=http://localhost:8090

# ═══ Empfohlen: Frontend-URL (für Passwort-Reset-Mails) ═══
# Die öffentlich erreichbare Adresse des Frontends (APP_PORT/Reverse-Proxy),
# NICHT die von API_EXTERNAL_URL. Ohne diesen Wert funktioniert die
# Passwort-Reset-Mail-Anforderung zwar, der Link darin zeigt aber ins Leere —
# kann auch nachträglich im PocketBase-Dashboard (/_/ → Settings →
# Application URL) gesetzt werden.
# Wenn nur LAN: APP_URL=http://192.168.1.50:8080
# Wenn extern via Reverse-Proxy: APP_URL=https://rapport.studio.ch
APP_URL=http://localhost:8080

# ═══ Optional: Ports ═══
APP_PORT=8080
PB_PORT=8090

# ═══ Optional: Image-Tags (Registry) ═══
# Welche fertigen Images `docker compose pull` holt. Selbst gebaut wird immer
# der Stand dieses Repos (`docker compose build`).
RAPPORT_APP_TAG=main
RAPPORT_PB_TAG=main
