# Vorlage fuer config.env — der Setup-Wizard generiert diese Werte beim
# Erst-Start automatisch (Zufalls-Passwoerter, siehe src-tauri/src/config.rs
# ensure_defaults) und persistiert sie in
# ~/Library/Application Support/com.rapport.server-app/config.env (macOS).
# Diese Datei dient nur als Referenz fuer manuelle Test-Runs.

# PocketBase-Superuser (Admin-UI unter /_/)
PB_SUPERUSER_EMAIL=admin@rapport.local
PB_SUPERUSER_PASSWORD=CHANGE-ME

API_EXTERNAL_URL=http://localhost:8090
# 127.0.0.1 = nur lokal, 0.0.0.0 = LAN-Zugriff (Vorsicht)
BIND_HOST=127.0.0.1

# Admin-WebUI (HTTPS, Basic-Auth als "admin")
ADMIN_UI_PASSWORD=CHANGE-ME
ADMIN_UI_PORT=9090
ADMIN_UI_BIND=127.0.0.1
ADMIN_UI_TLS=true

# Optional: Pfad zum Compose-Stack (sonst Auto-Detect, siehe services.rs)
# COMPOSE_DIR=/pfad/zu/rapport/server/container
